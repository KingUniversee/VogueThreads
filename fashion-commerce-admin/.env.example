# Database (MongoDB Atlas or local MongoDB)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fashion_admin?retryWrites=true&w=majority

# NextAuth / Session Secret
NEXTAUTH_SECRET=development_super_secret_session_key_32bytes_long_minimum
NEXTAUTH_URL=http://localhost:3000

# Media Storage (options: "local" | "s3")
STORAGE_PROVIDER=local

# Super Admin Seed Credentials
ADMIN_SEED_EMAIL=admin@voguethreads.in
ADMIN_SEED_PASSWORD=your_secure_seed_password_here

# AWS S3 / Cloudflare R2 (optional, used when STORAGE_PROVIDER="s3")
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_REGION=
# S3_ENDPOINT=
