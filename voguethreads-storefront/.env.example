# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Brand Configuration
NEXT_PUBLIC_BRAND_NAME=VOGUE THREADS
NEXT_PUBLIC_BRAND_TAGLINE="PREMIUM FASHION x MODERN TECH x FOR A BETTER YOU"

# Store Settings Defaults
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=999
NEXT_PUBLIC_STANDARD_SHIPPING_FEE=49

# Database Configuration
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/fashion_commerce_admin?retryWrites=true&w=majority

# Authentication Security (Minimum 32 characters, required for signed session cookies)
JWT_SECRET=your_super_secret_64_char_hex_key_here

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
